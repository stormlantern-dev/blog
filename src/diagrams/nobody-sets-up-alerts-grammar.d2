direction: down

want: "What you want to know:\n\"Is one position becoming\ntoo big a part of my portfolio?\""

form: "What the form asks" {
  grid-rows: 2
  grid-columns: 4
  grid-gap: 16
  instrument: "Instrument\nASML"
  value: "Value\nshare of portfolio"
  op: "Comparison\nat least"
  number: "Number\n35%"
  often: "How often\nonce / every time"
  until: "Until\n31 December"
  where: "Where\npush, email"
  name: "Name\nASML too big"
}

want -> form: "you translate" {
  style.stroke-dash: 4
}
