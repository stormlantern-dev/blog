---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';
import TagChip from '../components/TagChip.astro';
import Giscus from '../components/Giscus.astro';
import { minutesRead } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  prev: CollectionEntry<'posts'> | null;
  next: CollectionEntry<'posts'> | null;
}
const { post, prev, next } = Astro.props;
const { title, date, summary, tags, cover, coverAlt } = post.data;
const dateLabel = date.toISOString().slice(0, 10);
const minutes = await minutesRead(post);
// A post that fits on a screen or two has nothing to track: its body never
// covers the viewport, so the bar would start part-filled (PRD 0057, R3).
const MIN_MINUTES_FOR_PROGRESS = 3;
---
<BaseLayout title={title} description={summary} image={cover} imageAlt={coverAlt} type="article">
  <div class="container post">
    <!-- Reading progress (PRD 0057, R3–R6): CSS only. It follows the article
         body's view timeline (--article, scoped to .post), so the cover,
         post navigation and comments do not move it. Browsers without
         scroll-driven animations never show it. -->
    {minutes >= MIN_MINUTES_FOR_PROGRESS && <div class="reading-progress" aria-hidden="true"></div>}
    <!-- Only the post itself is inside <article>, so reader modes and
         read-aloud (R13) skip the navigation and comments below. -->
    <article>
    {cover && (
      <figure class="post-cover">
        <img src={cover} alt={coverAlt ?? ''} loading="eager" decoding="async" />
      </figure>
    )}
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{dateLabel}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {tags.length > 0 && <span class="sep">·</span>}
        {tags.map((tag) => <TagChip tag={tag} />)}
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
    </article>
    <script>
      // Screen recordings in posts (<video data-autoplay>): play while in
      // view, unless the reader asked for reduced motion. Always muted, and
      // the controls stay, so anyone can pause (WCAG 2.2.2).
      const still = window.matchMedia('(prefers-reduced-motion: reduce)');
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      if (videos.length && !still.matches && 'IntersectionObserver' in window) {
        const seen = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (!v.dataset.readerPaused) v.play().catch(() => {});
            } else if (!v.paused) {
              v.dataset.scrollPaused = '1';
              v.pause();
            }
          }
        }, { threshold: 0.6 });
        videos.forEach((v) => {
          v.muted = true;
          // A pause the reader made sticks; scrolling back does not undo it.
          v.addEventListener('pause', () => {
            if (v.dataset.scrollPaused) delete v.dataset.scrollPaused;
            else v.dataset.readerPaused = '1';
          });
          v.addEventListener('play', () => { delete v.dataset.readerPaused; });
          seen.observe(v);
        });
      }
    </script>

    <nav class="post-nav" aria-label="Post navigation">
      {prev ? (
        <a class="prev" href={`/posts/${prev.id}/`}>
          <span class="dir">← Previous</span>
          <span class="t">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a class="next" href={`/posts/${next.id}/`}>
          <span class="dir">Next →</span>
          <span class="t">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>

    <Giscus />
  </div>
</BaseLayout>

<style>
  .post {
    padding-top: var(--sl-space-8);
    padding-bottom: var(--sl-space-8);
    /* Lets the bar, outside .prose, use the timeline .prose defines. */
    timeline-scope: --article;
  }

  /* Reading progress ---------------------------------------------------- */
  .reading-progress { display: none; }
  @supports (animation-timeline: view()) {
    .prose { view-timeline: --article block; }
    .reading-progress {
      display: block;
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 10;
      pointer-events: none;
      background: var(--sl-color-accent);
      transform-origin: 0 50%;
      transform: scaleX(0);
      animation: reading-progress linear both;
      animation-timeline: --article;
      /* 0 when the body's top reaches the top of the viewport, 1 when its
         end reaches the bottom. */
      animation-range: contain 0% contain 100%;
    }
  }
  @keyframes reading-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress { transition: none; }
  }
  @media print {
    .reading-progress { display: none !important; }
  }

  .post-cover {
    margin: 0 0 var(--sl-space-8);
  }
  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--sl-radius-md);
  }

  .post-head { margin-bottom: var(--sl-space-8); }
  .post-head h1 {
    font-family: var(--sl-font-family-display);
    font-size: var(--sl-font-size-3xl);
    font-weight: var(--sl-font-weight-heavy);
    color: var(--sl-color-ink);
    line-height: var(--sl-font-line-height-tight);
    letter-spacing: var(--sl-font-letter-spacing-snug);
    margin: 0 0 var(--sl-space-3);
  }
  .post-head .meta {
    color: var(--sl-color-muted);
    font-size: var(--sl-font-size-sm);
    margin: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sl-space-2);
  }
  .post-head .sep { opacity: 0.5; }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sl-space-4);
    margin-top: var(--sl-space-12);
    padding-top: var(--sl-space-6);
    border-top: 1px solid var(--sl-color-line);
  }
  .post-nav a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-color-line);
    border-radius: var(--sl-radius-md);
  }
  .post-nav a:hover { border-color: var(--sl-color-accent); }
  .post-nav .next { text-align: right; grid-column: 2; }
  .post-nav .prev { grid-column: 1; }
  .post-nav .dir { font-size: var(--sl-font-size-sm); color: var(--sl-color-muted); }
  .post-nav .t { color: var(--sl-color-ink); margin-top: var(--sl-space-1); }

  @media (max-width: 540px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav .prev,
    .post-nav .next { grid-column: 1; text-align: left; }
  }
</style>
